# Required. At least 12 characters. This is the only sign-in password.
AUTH_PASSWORD=

# Required. At least 16 characters. Used to sign the login cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Where temporary downloads are stored. The container default is /tmp/transkrow,
# which disappears when the free host sleeps, restarts, or redeploys.
# DATA_DIR=/tmp/transkrow

# Minutes to keep a file that was never saved. Default 15. Range 5–60.
# A successful save deletes the file immediately.
# DELETE_AFTER_MINUTES=15

# Longest media accepted, in minutes. Default 90.
# MAX_DURATION_MINUTES=90

# Largest media file. A number of bytes, or a suffix: 150M. Default 150M.
# MAX_FILE_BYTES=150M

# How many downloads run at once. Leave this at 1 on a 512 MB host.
# MAX_CONCURRENT=1

# Playlist cap when the playlist box is checked. Default 3.
# MAX_PLAYLIST_ITEMS=3

# Stop new downloads when temporary files reach this size. Default 400M.
# MAX_DISK_BYTES=400M

# Kill a stuck download after this many minutes. Default 20.
# JOB_TIMEOUT_MINUTES=20

# New downloads allowed per minute from one address. Default 20.
# RATE_LIMIT_PER_MINUTE=20

# Sign-in attempts allowed per window. Defaults: 8 attempts, 15 minutes.
# LOGIN_RATE_LIMIT=8
# LOGIN_WINDOW_MINUTES=15

# Login cookie lifetime in hours. Default 168 (7 days).
# SESSION_TTL_HOURS=168

# Set to 1 on any HTTPS host (Render, Hugging Face, Koyeb).
# COOKIE_SECURE=1

# Optional. Absolute path to a Netscape cookies.txt inside the container.
# COOKIES_FILE=/tmp/transkrow/cookies.txt

# Optional. The text of a Netscape cookies.txt. Prefer a secret variable.
# Do not commit this value.
# COOKIES_CONTENT=

# Optional. http, https, or socks5 proxy URL for yt-dlp.
# A residential or ISP proxy is the usual fix when cookies are not enough.
# YTDLP_PROXY=socks5://user:pass@proxy.example:1080

# Optional binary overrides. The Docker image sets these.
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
